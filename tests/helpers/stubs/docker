#!/bin/bash
# Stub docker con stato in $STUB_STATE (un file per container, un argomento per riga).
S="${STUB_STATE:?}"; mkdir -p "$S/containers" "$S/models"; echo "docker $*" >> "$S/calls.log"
args_of() { cat "$S/containers/$1.args" 2>/dev/null; }
gpus_of() { # valore di --gpus per il container
  local prev=""; while IFS= read -r l; do [ "$prev" = "--gpus" ] && { printf '%s\n' "$l"; return; }; prev="$l"; done < <(args_of "$1"); }
case "$1" in
  ps)      ls "$S/containers" 2>/dev/null | sed 's/\.args$//' ;;
  network) [ "$2" = "ls" ] && echo "ollama_default" ;;
  start|stop) exit 0 ;;
  rm)      shift; [ "$1" = "-f" ] && shift; rm -f "$S/containers/$1.args" "$S/containers/$1.image"; echo "$1" ;;
  run)     shift; name=""; : > "$S/tmp.args"
           while [ $# -gt 0 ]; do case "$1" in -d) shift;; --name) name="$2"; shift 2;; --restart) shift 2;; *) printf '%s\n' "$1" >> "$S/tmp.args"; shift;; esac; done
           # docker vero: il primo argomento posizionale (non valore di un opzione) e l IMMAGINE; senza, errore.
           valued=" -v -p -e --network --net --gpus --restart --env-file --add-host --entrypoint -w --user -u --memory -m --cpus --hostname -h --label -l --volume --publish --env --mount --device --ulimit --shm-size --security-opt --cap-add --log-driver --dns "
           img=""; skip=0
           while IFS= read -r tok; do
             if [ $skip = 1 ]; then skip=0; continue; fi
             case "$tok" in -*=*) ;; -*) [[ "$valued" == *" $tok "* ]] && skip=1 ;; *) img="$tok"; break ;; esac
           done < "$S/tmp.args"
           [ -n "$img" ] || { echo "docker: 'docker run' requires at least 1 argument" >&2; rm -f "$S/tmp.args"; exit 125; }
           [ -n "$FAKE_RUN_FAIL" ] && [ "$name" = "$FAKE_RUN_FAIL" ] && { echo "docker: Error response from daemon: simulated failure" >&2; rm -f "$S/tmp.args"; exit 125; }
           mv "$S/tmp.args" "$S/containers/$name.args"; echo "$img" > "$S/containers/$name.image"; echo "fakeid" ;;
  rename)  shift; [ -f "$S/containers/$1.args" ] || exit 1; mv "$S/containers/$1.args" "$S/containers/$2.args"
           [ -f "$S/containers/$1.image" ] && mv "$S/containers/$1.image" "$S/containers/$2.image"; exit 0 ;;
  images)  [ -n "$FAKE_IMAGES" ] && printf '%s\n' $FAKE_IMAGES; exit 0 ;;
  image)   shift; if [ "$1" = inspect ]; then img="${@: -1}"; rev=$(cat "$S/imagerev" 2>/dev/null || echo 1)
             echo "sha256:$(printf '%s%s' "$img" "$rev" | md5sum | cut -d' ' -f1)"; fi; exit 0 ;;
  pull)    [ -n "$FAKE_PULL_UPDATES" ] && echo $(( $(cat "$S/imagerev" 2>/dev/null || echo 1) + 1 )) > "$S/imagerev"; exit 0 ;;
  inspect) c="${@: -1}"; [ -f "$S/containers/$c.args" ] || exit 1
           if [[ "$*" == *Labels* ]]; then prev=""; while IFS= read -r l; do [ "$prev" = "--label" ] && [[ "$l" == orchestra.image_id=* ]] && { echo "${l#orchestra.image_id=}"; }; prev="$l"; done < <(args_of "$c"); exit 0; fi
           if [[ "$*" == *Config.Image* ]]; then cat "$S/containers/$c.image" 2>/dev/null; exit 0; fi
           if [[ "$*" == *DeviceRequests* ]]; then g="$(gpus_of "$c")"
             case "$g" in device=*) echo "[{\"Driver\":\"nvidia\",\"DeviceIDs\":[\"${g#device=}\"]}]";; all) echo '[{"Driver":"nvidia","Count":-1,"DeviceIDs":null}]';; *) echo "null";; esac
           else prev=""; while IFS= read -r l; do [ "$prev" = "-e" ] && printf '%s\n' "$l"; prev="$l"; done < <(args_of "$c"); fi ;;
  exec)    shift; c="$1"; shift
           case "$1 $2" in
             "nvidia-smi -L") g="$(gpus_of "$c")"
                if [ "${g#device=}" != "$g" ]; then PATH="${STUB_BIN}:$PATH" nvidia-smi -L | grep "UUID: ${g#device=})"
                else PATH="${STUB_BIN}:$PATH" nvidia-smi -L; fi ;;
             "ollama list") echo "NAME ID SIZE MODIFIED"; cat "$S/models/$c" 2>/dev/null | sed 's/$/  x  1GB  now/' ;;
             "ollama pull") if [ -n "$FAKE_PULL_FAIL" ] && [ "$3" = "$FAKE_PULL_FAIL" ]; then echo "pull failed: $3" >&2; exit 1; fi
                echo "$3" >> "$S/models/$c"; echo "pulled $3" ;;
             "ollama --version") echo "ollama version is ${FAKE_OLLAMA_VERSION:-0.99.0}" ;;
             "ollama ps") echo "NAME ID SIZE PROCESSOR UNTIL"
                m="$(cat "$S/loaded_$c" 2>/dev/null)"; [ -n "$m" ] && echo "$m abc 9.0 GB ${FAKE_PROC:-100% GPU} 4 minutes from now" ;;
             *) exit 0 ;;
           esac ;;
  *) exit 0 ;;
esac
